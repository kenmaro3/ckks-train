+/// One future paired-HE driver's shared oracle phase; constructing it grants no runtime authority.
+/// No Clone, Default, reset, mutable report or caller-selected limits are exposed.
+pub(crate) struct PairedOraclePhase {
+    report: Report,
+    oracles: usize,
+}
+#[allow(dead_code)] // Closed future consumer; source-only phase never invokes its oracle method.
+impl PairedOraclePhase {
+    pub(crate) fn new() -> Self {
+        Self {
+            report: Report::paired(),
+            oracles: 0,
+        }
+    }
+    /// Actual reservations in fixed order: oracle calls, Engine objects, train calls, external forwards.
+    pub(crate) fn actual_counts(&self) -> [usize; 4] {
+        [
+            self.oracles,
+            self.report.counts.engines,
+            self.report.counts.train,
+            self.report.counts.forward,
+        ]
+    }
+    pub(crate) fn check_complete(&self) -> std::result::Result<(), String> {
+        if self.oracles == PAIRED_ORACLES
+            && self.report.counts == PAIRED_LIMITS
+            && self.report.failures.is_empty()
+        {
+            Ok(())
+        } else {
+            Err(format!(
+                "paired oracle phase incomplete/failed: actual={:?} expected=[14,14,40,128] failures={:?}",
+                self.actual_counts(),
+                self.report.failures
+            ))
+        }
+    }
+    /// Same immutable recipe/baseline path and actual guarded sites, with one shared aggregate report.
+    pub(crate) fn oracle(
+        &mut self,
+        family: BlockFamily,
+    ) -> std::result::Result<BlockOracle, String> {
+        assert!(
+            self.oracles < PAIRED_ORACLES,
+            "actual oracle cap reached before call: {family:?}"
+        );
+        self.oracles += 1;
+        println!(
+            "NONSCIENTIFIC_TEST_EVIDENCE BEFORE_CALL kind=oracle actual={} cap={PAIRED_ORACLES} context={family:?}/paired",
+            self.oracles
+        );
+        let recipe = family.recipe();
+        manifest(&recipe, &mut self.report);
+        let oracle = baseline(recipe, &mut self.report);
+        if !self.report.failures.is_empty() || oracle.steps.len() != oracle.recipe.rates.len() {
+            Err(format!("{:?}", self.report))
+        } else {
+            Ok(oracle)
+        }
     }
 }
