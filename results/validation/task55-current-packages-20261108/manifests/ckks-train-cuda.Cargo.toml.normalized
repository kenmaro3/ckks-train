[package]
edition = "2024"
rust-version = "1.85"
name = "ckks-train-cuda"
version = "1.0.0"
build = false
autolib = false
autobins = false
autoexamples = false
autotests = false
autobenches = false
description = "CUDA backend for the ckks-train RNS-CKKS library: NTT, key switching and the evaluator on the GPU, bit-identical to the CPU"
readme = "README.md"
keywords = [
    "ckks",
    "fhe",
    "cuda",
    "gpu",
    "homomorphic",
]
categories = [
    "cryptography",
    "hardware-support",
]
license = "MIT"
repository = "https://github.com/kenmaro3/ckks-train"

[package.metadata.docs.rs]
features = ["cuda"]

[features]
cuda = ["dep:cudarc"]

[lib]
name = "ckks_train_cuda"
path = "src/lib.rs"

[[example]]
name = "batch_streams"
path = "examples/batch_streams.rs"
required-features = ["cuda"]

[[test]]
name = "bootstrap_replay"
path = "tests/bootstrap_replay.rs"

[[test]]
name = "gpu"
path = "tests/gpu.rs"

[[test]]
name = "gpu_arith"
path = "tests/gpu_arith.rs"

[[test]]
name = "gpu_bootstrap"
path = "tests/gpu_bootstrap.rs"

[[test]]
name = "gpu_eval"
path = "tests/gpu_eval.rs"

[[test]]
name = "gpu_ks"
path = "tests/gpu_ks.rs"

[dependencies.ckks-train-ckks]
version = "1.0.0"

[dependencies.ckks-train-core]
version = "1.0.0"

[dependencies.cudarc]
version = "=0.19.0"
features = [
    "std",
    "driver",
    "nvrtc",
    "cuda-13010",
    "dynamic-loading",
]
optional = true
default-features = false

[dev-dependencies.ckks-train-nn]
version = "1.0.0"

[dev-dependencies.rand_chacha]
version = "0.9"

[dev-dependencies.rand_core]
version = "0.9"
