[package]
edition = "2024"
rust-version = "1.85"
name = "ckks-train-core"
version = "1.0.0"
build = false
autolib = false
autobins = false
autoexamples = false
autotests = false
autobenches = false
description = "RNS arithmetic, NTT and sampling primitives of ckks-train, an RNS-CKKS library for encrypted neural-network training"
readme = "README.md"
keywords = [
    "fhe",
    "rns",
    "ntt",
    "lattice",
    "homomorphic",
]
categories = [
    "cryptography",
    "mathematics",
]
license = "MIT"
repository = "https://github.com/kenmaro3/ckks-train"

[lib]
name = "ckks_train_core"
path = "src/lib.rs"

[[test]]
name = "modulus_prop"
path = "tests/modulus_prop.rs"

[[bench]]
name = "ntt"
path = "benches/ntt.rs"
harness = false

[dependencies.rand_chacha]
version = "0.9"

[dependencies.rand_core]
version = "0.9"
features = ["os_rng"]

[dev-dependencies.criterion]
version = "0.5"
features = ["cargo_bench_support"]
default-features = false

[dev-dependencies.proptest]
version = "1"
