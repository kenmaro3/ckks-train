[package]
edition = "2024"
rust-version = "1.85"
name = "ckks-train-ckks"
version = "1.0.0"
build = "build.rs"
autolib = false
autobins = false
autoexamples = false
autotests = false
autobenches = false
description = "RNS-CKKS homomorphic encryption with hybrid key switching, hoisted rotations, BSGS matrix-vector products and SSE bootstrapping (ckks-train)"
readme = "README.md"
keywords = [
    "ckks",
    "fhe",
    "homomorphic",
    "bootstrapping",
    "encryption",
]
categories = [
    "cryptography",
    "mathematics",
]
license = "MIT"
repository = "https://github.com/kenmaro3/ckks-train"

[features]
parallel = ["dep:rayon"]

[lib]
name = "ckks_train_ckks"
path = "src/lib.rs"

[[example]]
name = "export_params"
path = "examples/export_params.rs"

[[example]]
name = "precision"
path = "examples/precision.rs"

[[test]]
name = "bootstrap_metadata"
path = "tests/bootstrap_metadata.rs"

[[test]]
name = "metadata"
path = "tests/metadata.rs"

[[test]]
name = "precision"
path = "tests/precision.rs"

[[test]]
name = "seal_kat"
path = "tests/seal_kat.rs"

[[bench]]
name = "bootstrap"
path = "benches/bootstrap.rs"
harness = false
required-features = ["parallel"]

[[bench]]
name = "rotate"
path = "benches/rotate.rs"
harness = false

[dependencies.ckks-train-core]
version = "1.0.0"

[dependencies.ndarray]
version = "0.16"

[dependencies.num-complex]
version = "0.4"

[dependencies.rayon]
version = "1.10"
optional = true

[dev-dependencies.criterion]
version = "0.5"
features = ["cargo_bench_support"]
default-features = false

[dev-dependencies.rand_chacha]
version = "0.9"

[dev-dependencies.rand_core]
version = "0.9"
