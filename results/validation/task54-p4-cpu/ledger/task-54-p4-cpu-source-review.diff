+fn reserve(cell: &Cell<usize>, cap: usize, name: &str) {
+    let next = cell.get().checked_add(1).expect("guard overflow");
+    eprintln!(
+        "P4_RESERVE operation={name} before={} next={next} cap={cap}",
+        cell.get()
+    );
+    assert!(next <= cap, "P4 {name} cap");
+    cell.set(next);
+}
