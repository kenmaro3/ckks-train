+                &c.command,
+                &c.source_manifest,
+                &c.criterion_policy,
+            ] {
+                f.validate()?;
+            }
+            self.applicability.exact(&c.applicability)?;
+        }
+        let s = &self.security;
+        file_list(&s.estimator_sources, true)?;
+        for f in [
+            &s.policy,
+            &s.parameter_export,
+            &s.environment,
+            &s.command,
+            &s.model_config,
+        ] {
+            f.validate()?;
+        }
+        for (i, instance) in s.instances.iter().enumerate() {
+            same(instance.role.0 == i as u8, "security.instance.role")?;
+            for f in [
+                &instance.problem,
+                &instance.bdgl16_raw,
+                &instance.matzov_raw,
+            ] {
+                f.validate()?;
+            }
+        }
+        same(
+            self.construction_obligations.len() == count + 3
+                && self
+                    .construction_obligations
+                    .iter()
+                    .enumerate()
+                    .all(|(i, t)| t.0 == i as u8),
+            "implementation.obligations",
+        )
+    }
