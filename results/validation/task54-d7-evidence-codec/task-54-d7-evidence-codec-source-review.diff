+    )?;
+    if let Some(eval) = &case.eval_config {
+        same(
+            eval.hoist == x.eval.hoist
+                && eval.bsgs == x.eval.bsgs
+                && eval.lazy_relin == x.eval.lazy_relin,
+            "evidence.case.eval",
+        )?;
+    }
+    Ok(())
+}

