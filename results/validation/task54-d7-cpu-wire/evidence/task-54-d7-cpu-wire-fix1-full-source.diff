+                total,
+                a.count
+                    .checked_mul(a.element_bytes)
+                    .ok_or_else(|| err(DocumentErrorCode::TooLarge, "demand.product"))?,
+            )?;
+        }
+        same(
+            total == add(self.retained_payload_bytes, self.additional_payload_bytes)?,
+            "demand.sum",
+        )
+    }
