+impl SourceDemand<'_> {
+    pub(in crate::study_reference::document::evidence) fn validate(&self) -> Result<()> {
+        same(
+            self.phase.0 <= 4 && self.allocations.len() <= 512,
+            "demand.bounds",
+        )?;
+        let mut prior = None;
+        let mut total = 0;
+        for a in &self.allocations {
+            let s = a.site.0;
+            let family = [
+                "raw",
+                "decoded_f64",
+                "cast_f32",
+                "order",
+                "initial",
+                "plan",
+                "params",
+                "keys",
+                "ciphertext",
+                "fp32",
+                "snapshot",
+                "result",
+            ]
+            .iter()
+            .any(|f| {
+                s == *f
+                    || s.strip_prefix(f)
+                        .and_then(|s| s.strip_prefix('_'))
+                        .is_some_and(|v| {
+                            !v.is_empty()
+                                && v.bytes().all(|b| b.is_ascii_digit())
+                                && (v == "0" || !v.starts_with('0'))
+                                && v.parse::<u64>().is_ok()
