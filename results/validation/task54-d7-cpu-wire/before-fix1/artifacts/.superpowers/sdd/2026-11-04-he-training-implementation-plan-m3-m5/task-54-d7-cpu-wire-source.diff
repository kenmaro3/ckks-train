+fn compiled_request(b: &[u8]) -> Result<u8> {
+    same(b.len() == 62, "work.request.length")?;
+    let mut c = Cursor::new(b);
+    let scope = c.tag(1)?;
+    same(c.take(5)? == [0, 0, 1, 1, 1], "work.request.options")?;
+    for n in [
+        67_108_864,
+        1_000_000,
+        2,
+        2,
+        if scope == 0 { 2400 } else { 2 },
+        0,
+        1,
+    ] {
+        same(c.u64()? == n, "work.request.compiled")?;
+    }
+    c.finish()?;
+    Ok(scope)
