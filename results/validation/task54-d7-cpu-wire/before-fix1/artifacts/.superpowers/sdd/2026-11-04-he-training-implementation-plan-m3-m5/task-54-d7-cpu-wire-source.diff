+    let mut c = cursor(b, "resource-observed-samples", 1, mode, 64 * 1024 * 1024)?;
+    let claim = FileRef::read(&mut c)?;
+    claim.validate()?;
+    let mut sequence = 0;
+    let mut last = None;
+    while c.remaining() > 0 {
+        let mut len = [0; 4];
+        len.copy_from_slice(c.take(4)?);
+        let len = u32::from_le_bytes(len) as usize;
+        same((63..=159).contains(&len), "samples.frame")?;
