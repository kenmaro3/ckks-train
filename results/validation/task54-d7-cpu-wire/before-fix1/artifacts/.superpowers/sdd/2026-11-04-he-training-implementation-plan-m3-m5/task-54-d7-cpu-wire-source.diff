+            e.byte(0)
+        } else {
+            e.byte(1)?;
+            T::encode_json(r, p, e)
+        }
+    }
+    fn json(&self) -> Value {
+        self.as_ref().map_or(Value::Null, JsonWire::json)
+    }
+    fn write_json(&self, out: &mut Vec<u8>) -> Result<()> {
+        match self {
+            Some(v) => v.write_json(out),
