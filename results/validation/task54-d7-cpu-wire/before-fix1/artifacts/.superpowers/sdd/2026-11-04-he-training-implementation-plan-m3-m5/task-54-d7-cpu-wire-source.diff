+        let v = u64::decode(r, p)?;
+        ensure(v <= u64::from(M), DocumentErrorCode::UnsupportedTag, p)?;
+        e.byte(v as u8)
+    }
+    fn json(&self) -> Value {
+        json!(self.0)
+    }
+}
+impl<'a, const N: usize> JsonWire<'a> for Str<'a, N> {
