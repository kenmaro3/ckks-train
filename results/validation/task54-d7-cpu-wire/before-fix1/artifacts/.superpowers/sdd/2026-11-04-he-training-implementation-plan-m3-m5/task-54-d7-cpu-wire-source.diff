+        for x in v.0 {
+            T::encode_json(&x.0, p, e)?;
+        }
+        Ok(())
+    }
+    fn json(&self) -> Value {
+        Value::Array(self.iter().map(JsonWire::json).collect())
+    }
+    fn write_json(&self, out: &mut Vec<u8>) -> Result<()> {
+        write_array(out, self.iter())
+    }
