+    #[test]
+    fn bsgs_identity_with_offset_in_the_clear() {
+        let mut r = rng(40);
+        for (d, slots, stride, offset) in [(16, 64, 1, -8), (8, 64, 4, -4), (4, 16, 2, -3)] {
+            let diags: Vec<Vec<f64>> = (0..d).map(|_| rand_vals(&mut r, slots)).collect();
+            let x = rand_vals(&mut r, slots);
