+/// Shared scalar arithmetic, preserving the original iterator sum/order exactly.
+fn interpolation_fill(
+    f: impl Fn(f64) -> f64,
+    a: f64,
+    b: f64,
+    theta: &mut [f64],
+    fx: &mut [f64],
+    output: &mut [f64],
