+impl FileRef {
+    fn validate(&self, p: &str) -> SResult<()> {
+        let s = &self.path.0;
+        require(
+            !s.is_empty()
+                && !s.starts_with('/')
+                && !s.contains(['\0', '\\'])
+                && s.split('/').all(|c| !matches!(c, "" | "." | "..")),
+            "path",
+            p,
+        )
+    }
+    fn key(&self) -> (u8, &str) {
+        (self.root.0, &self.path.0)
