+impl Decode for FileRef {
+    fn decode(r: &RawValue, p: &str) -> Result<Self> {
+        let mut f = Fields::new(r, &["root", "path", "length", "sha256"], p)?;
+        let v = Self {
+            root: f.field("root", p)?,
+            path: f.field("path", p)?,
+            length: f.field("length", p)?,
+            sha256: f.field("sha256", p)?,
+        };
+        v.validate(&path(p, "path"))
