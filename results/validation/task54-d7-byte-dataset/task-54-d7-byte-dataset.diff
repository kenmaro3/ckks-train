+        &q,
+        DatasetBytes::IrisCsv {
+            csv: CSV,
+            split: b"train:0,1\ntest:2\n",
+        },
+    )
+    .unwrap();
+    assert_eq!(b.train_y, [0, 1]);
+    assert_ne!(a.files[1].1, b.files[1].1);
