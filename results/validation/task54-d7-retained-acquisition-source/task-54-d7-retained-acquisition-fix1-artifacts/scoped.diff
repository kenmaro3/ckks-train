+    fn retained_native_original_guard_and_same_address_store_replacement_refuse() {
+        let d = Scratch::new("original-guard-owner");
+        d.write(".profile-guard", b"");
+        d.write("target.lock.json", b"data");
+        let open = || {
+            TargetStore::from_opened(
+                Anchors::open(&d.0).unwrap(),
