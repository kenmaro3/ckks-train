+                existing_profile_guard(&File::open(&d.0).unwrap()).unwrap(),
+            )
+            .unwrap()
+        };
+        let mut store = open();
+        let address = &store as *const TargetStore as usize;
+        let original = store.retained_origin().unwrap();
+        let held = store.read_held().unwrap();
+        store.recheck_read(&held, &original).unwrap();
+        std::fs::rename(d.0.join(".profile-guard"), d.0.join("original-guard")).unwrap();
+        d.write(".profile-guard", b"");
+        assert!(store.recheck_read(&held, &original).is_err());
+        let original_inode = inode(&original.guard_file).unwrap();
+        store = open();
+        assert_eq!(address, &store as *const TargetStore as usize);
+        store.recheck().unwrap(); // Replacement agrees with its NEW guard only.
+        assert_ne!(store.guard, original_inode);
+        assert!(store.recheck_read(&held, &original).is_err());
+        drop(store);
+        // The original guard inode and owner allocation survive the old store.
+        assert_eq!(inode(&original.guard_file).unwrap(), original_inode);
+        held.recheck().unwrap(); // Lock itself was not replaced; rejection is owner/guard continuity.
+    }
