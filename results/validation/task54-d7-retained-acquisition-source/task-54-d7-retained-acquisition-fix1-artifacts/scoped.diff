+        require_same_store_owner(&held, &snapshot).unwrap();
+        assert!(require_same_store_owner(&owner((3, 7)), &snapshot).is_err());
+        drop(held);
+        drop(snapshot);
+        assert!(weak.upgrade().is_none());
