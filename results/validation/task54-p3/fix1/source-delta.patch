+#[test]
+fn p3_fix1_late_finalization_retains_complete_prefix() {
+    let f = fixtures();
+    let p = f.iris.get_or_init(|| {
+        eprintln!("P3 fix1 canonical Iris materializations=1");
+        materialize(&f.registry.resolve("iris__mlp2020", 0).unwrap()).unwrap()
+    });
+    let case = main_case("iris__mlp2020", CasePlacement::ClientRefresh);
+    let mut request = request();
+    let params = parameters(CasePlacement::ClientRefresh);
+    let plan = plan_diagonal(p, case, params, &request).unwrap();
+    let final_bytes = std::mem::size_of_val(plan.full_rates())
+        + plan.full_plan_sha256().len()
+        + 64
+        + std::mem::size_of_val(plan.keys().training_rotations());
+    request.limits.max_bytes = plan.charges().combined() - final_bytes;
+    let error = plan_diagonal(p, case, params, &request).unwrap_err();
+    eprintln!(
+        "P3 fix1 late-finalization usage {:?}; cap={} completed={} prefix_records={}",
+        f.budget.usage(),
+        request.limits.max_bytes,
+        error.completed_updates(),
+        error.completed_prefix_transitions().len()
+    );
+    assert_eq!(error.completed_updates(), 2);
+    assert_eq!(error.phase(), IssuePhase::Finalization);
+    assert_eq!(error.stage(), None);
+    assert_eq!(error.update(), None);
+    assert_eq!(error.completed_prefix_transitions().len(), 2);
+    assert_eq!(error.kind(), IssueKind::PlanningBudgetExceeded);
+    let required = request.limits.max_bytes
+        + std::mem::size_of_val(plan.full_rates())
+        + plan.full_plan_sha256().len()
+        + 64;
+    assert_eq!(
+        error.budget_requirement(),
+        Some((required, request.limits.max_bytes))
+    );
+    for (i, r) in error.completed_prefix_transitions().iter().enumerate() {
+        assert_eq!(r.update(), i);
+        assert_eq!(r.stage(), 0);
+        assert_eq!(
+            r.update_metadata().unwrap().post_state().weights(),
+            plan.transitions()[i]
+                .update_metadata()
+                .unwrap()
+                .post_state()
+                .weights()
+        );
+    }
+    let start = plan.canonical_bytes().len()
+        - plan
+            .transitions()
+            .iter()
+            .enumerate()
+            .map(|(i, _)| plan.receipt_bytes(i).unwrap().len())
+            .sum::<usize>();
+    assert_eq!(
+        &error.completed_prefix_bytes()[start..],
+        &plan.canonical_bytes()[start..]
+    );
+}
