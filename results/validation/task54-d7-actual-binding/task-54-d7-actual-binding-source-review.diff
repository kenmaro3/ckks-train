+        let (om, oc, or) = self.owners();
+        if !std::ptr::eq(m, om) || !std::ptr::eq(c, oc) || !std::ptr::eq(r, or) {
+            return Err(crate::study_diagonal::mismatch("retained route owners").into());
+        }
